package templates

import (
	api "github.com/nstehr/bobcaygeon/cmd/mgmt/api"
	"github.com/nstehr/bobcaygeon/cmd/frontend/templates/components"
)

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Bobcaygeon</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<script src="/static/htmx.min.js"></script>
			<script src="https://unpkg.com/htmx.org/dist/ext/sse.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
			<script>
				tailwind.config = {
					darkMode: 'class',
					theme: {
						extend: {
							colors: {
								dark: {
									bg: '#0a0a0a',
									surface: '#141414',
									elevated: '#1e1e1e',
									border: '#2a2a2a',
									text: {
										primary: '#ffffff',
										secondary: '#a0a0a0',
										muted: '#666666',
									}
								},
								accent: {
									primary: '#22c55e',
									hover: '#16a34a',
								}
							}
						}
					}
				}
			</script>
			<style type="text/tailwindcss">
				@layer base {
					body {
						@apply bg-dark-bg text-dark-text-primary antialiased;
					}
				}
			</style>
		</head>
		<body class="min-h-screen">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
				<header class="mb-8">
					<h1 class="text-3xl font-light tracking-wide text-center">
						<span class="text-accent-primary">Bobcaygeon</span>
					</h1>
				</header>
				<main>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ Index(speakers []*api.Speaker) {
	@Layout("Home") {
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<div class="lg:col-span-2">
				@components.SpeakersList(speakers)
			</div>
			<div>
				<!-- Web Player loads here -->
				<div hx-get="/api/web-player" 
				     hx-trigger="load"
				     hx-swap="innerHTML">
					<div class="animate-pulse bg-dark-elevated rounded-xl h-64"></div>
				</div>
			</div>
		</div>
	}
}